# ═══════════════════════════════════════════════════════
#  Glacerie Alain Ducasse — Variables d'environnement
#  À configurer dans Render > Environment Variables
# ═══════════════════════════════════════════════════════

# ─── API Anthropic (OCR étiquettes) ──────────────────
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Stockage persistant Upstash Redis ───────────────
# OBLIGATOIRE pour ne pas perdre les données entre redéploiements
#
# 1. Créez un compte GRATUIT sur https://upstash.com
# 2. Cliquez "Create Database" → choisissez "Redis"
# 3. Nommez-la "glacerie-ducasse", région "eu-west-1" (Paris)
# 4. Dans "REST API", copiez les deux valeurs ci-dessous
UPSTASH_REDIS_REST_URL="https://grateful-colt-41897.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AaOpAAIgcDEzMWQ0ZDFjYjdhYWM0YWUwYmViNzUwYzQzNTU2MWFiZQ"

# ─── Stockage partagé (ne pas changer) ───────────────
VITE_USE_SERVER_STORAGE=true

# ─── Cookie de session ───────────────────────────────
# Clé secrète pour signer les cookies de session.
# Générez une valeur aléatoire : openssl rand -hex 32
# NE JAMAIS committer une vraie valeur ici.
APP_COOKIE_SECRET=CHANGE_ME_RANDOM_SECRET_64_CHARS

# ─── Comptes utilisateurs ────────────────────────────
# Tableau JSON des comptes. NE JAMAIS mettre dans le code source.
# Rôles disponibles : "equipier" | "adjoint" | "responsable"
#
# Exemple (à remplacer par les vrais identifiants dans Render) :
# APP_ACCOUNTS=[{"id":"marie","name":"Marie","password":"motdepasse","role":"responsable"},{"id":"thomas","name":"Thomas","password":"motdepasse","role":"equipier"}]
#
# NE JAMAIS committer les vrais mots de passe — définissez APP_ACCOUNTS dans Render Environment Variables
APP_ACCOUNTS=[]

# ─── Port (Render le définit automatiquement) ────────
# PORT=3000
